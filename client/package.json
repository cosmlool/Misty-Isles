    "verify:project": "node scripts/verify-project.mjs && npm run audit:assets && npm run build"
  },
  "dependencies": {
    "colyseus.js": "^0.16.22"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
